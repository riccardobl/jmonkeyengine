MaterialDef GradientFog {
    MaterialParameters {
        #for i=0..6 ( $0 )
            Texture2D Scene$i 
            Texture2D Depth$i 
            UniformBufferObject SceneCamera$i
        #endfor 


        Vector2 Density : 10.0 1.0

        Texture2D FogGradient 


        Boolean NoFogOnSky

        Vector3 FogHeight : 0.0 10.0 0.0
        Vector3 FogOrigin : 0.0 0.0 0.0


    }

    Technique {
        VertexShader GLSL150:  Pipeline/GradientFog/gradientFog.vert
        FragmentShader GLSL150: Pipeline/GradientFog/gradientFog.frag

     

        Defines {
            #for i=0..6 ( $0 )
                SCENE_$i:Scene$i
                DEPTH_$i:Depth$i
                NO_FOG_ON_SKY: NoFogOnSky
            #endfor
        }
    }
}