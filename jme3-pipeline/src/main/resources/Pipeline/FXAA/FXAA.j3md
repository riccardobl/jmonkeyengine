MaterialDef FXAA {
    MaterialParameters {
        #for i=0..6 ( $0 )
            Texture2D Input$i
        #endfor 

        Texture2D InputDepth

        Float SubPixelShift : 0.25
        Float SpanMax : 8
        Float ReduceMul : 0.123


        UniformBufferObject WorldCamera
    }

    Technique {
        VertexShader GLSL150:  Pipeline/FXAA/fxaa.vert
        FragmentShader GLSL150: Pipeline/FXAA/fxaa.frag

        Defines {
            #for i=0..6 ( $0 )
                SCENE_$i:Input$i
            #endfor 
            DEPTH:InputDepth
        }
    }
}